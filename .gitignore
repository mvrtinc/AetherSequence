# Сборочные папки: собираются локально, в репозитории им не место
bin/
obj/
dist/

# Настройки конкретного игрока (создаются при первом запуске)
settings.json
*.user

# Логи и временные файлы
*.log
*.tmp

# Локальные базы и кэши (в т.ч. из tg-sales)
data/
__pycache__/
*.pyc
.venv/

# Секреты. Настоящий токен Telegram-бота не должен попасть в историю.
.env

# Скриншоты для разработки
shots/
